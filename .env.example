# Copy this file to .env and fill in real values. NEVER commit .env.

# ---------- DATA: Zetaris (local Docker install) ----------
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key          # create it yourself in the Zetaris web UI
# Used by smoke_test.py only:
ZETARIS_BASE_URL=http://localhost:3000

# ---------- POWER: Meterless Nightshift (the only model provider) ----------
# Copy the Runtime URL and token from Nightshift > Console (top right). NOT your NVIDIA key.
MODEL_PROVIDER=meterless
METERLESS_APP=whybot
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token
# A Meterless routing mode. Local Nemotron lane: meterless/text.local
# (plain meterless/local can be coerced to auto). Cloud lanes: meterless/deep.
NEMOTRON_MODEL=meterless/text.local

# ---------- WhyBot ----------
# The investigation's "today". The demo data ends Sun 2026-10-18.
WHYBOT_AS_OF=2026-10-19
# Context window of your model lane, in tokens. Leave empty for cloud lanes.
# For a local Nemotron lane added with ctx 10k in Nightshift, set 10000: WhyBot
# then uses compact prompts and sizes each answer to fit.
WHYBOT_CONTEXT_TOKENS=10000
