# Copy this file to .env and fill in real values. NEVER commit .env.

# ---------- DATA: Zetaris (local Docker install) ----------
# Zetaris REST API base
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Numeric Zetaris organisation id
ZETARIS_ORG_ID=1
# Zetaris API key: create it in the Zetaris web UI (Management -> API Tokens)
ZETARIS_API_KEY=your-zetaris-api-key
# Zetaris web UI base (used by smoke_test.py only)
ZETARIS_BASE_URL=http://localhost:3000

# ---------- POWER: Meterless Nightshift (the only model provider) ----------
# Model provider name (only meterless is supported)
MODEL_PROVIDER=meterless
# App id sent to Nightshift for usage attribution
METERLESS_APP=whybot
# Nightshift Runtime URL (Nightshift > Console, top right)
MODEL_BASE_URL=http://127.0.0.1:8088/v1
# Nightshift Runtime token (Nightshift > Console). NOT your NVIDIA key.
MODEL_API_KEY=your-nightshift-runtime-token
# Routing mode: meterless/text.local for a local Nemotron lane (plain meterless/local can be coerced to auto), meterless/deep for cloud lanes
NEMOTRON_MODEL=meterless/text.local
# Optional model for the step-to-step state compressor; empty = same as NEMOTRON_MODEL
WHYBOT_COMPRESSOR_MODEL=
# Seconds to wait for one model call (default 180)
WHYBOT_CALL_TIMEOUT_S=180
# Reasoning effort sent with model calls: low (default), medium, high, or none to omit it
WHYBOT_REASONING_EFFORT=low

# ---------- WhyBot ----------
# The investigation's "today". The demo data ends Sun 2026-10-18.
WHYBOT_AS_OF=2026-10-19
# Context window of your model lane in tokens; empty for cloud lanes, 10000 for a local lane with ctx 10k (enables compact prompts)
WHYBOT_CONTEXT_TOKENS=10000
# Host the web UI binds to (default 127.0.0.1; do not expose without an authenticated tunnel)
WHYBOT_HOST=127.0.0.1
# Port for the web UI (default 4173)
WHYBOT_PORT=4173

# ---------- Demo Postgres (data/docker-compose.yml) ----------
# Password for the demo Postgres container (default whybot_local_dev)
WHYBOT_PG_PASSWORD=whybot_local_dev
