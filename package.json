{
  "name": "whybot",
  "version": "0.1.0",
  "private": true,
  "description": "WhyBot: an agent that explains why your numbers moved, with evidence. Zetaris + Meterless + NVIDIA Nemotron.",
  "type": "module",
  "scripts": {
    "dev": "npm run data:up && npm run web:build && npm run serve",
    "why": "tsx src/cli.ts why",
    "check": "tsx src/cli.ts check",
    "demo:facts": "tsx scripts/demo-facts.ts",
    "memory": "tsx src/cli.ts memory",
    "serve": "tsx src/server.ts",
    "web:build": "npm --prefix web run build",
    "web:install": "npm --prefix web ci",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx --test smoke/*.test.ts",
    "conformance": "tsx scripts/conformance.ts",
    "data:generate": "tsx scripts/generate-data.ts",
    "data:up": "docker compose -f data/docker-compose.yml up -d",
    "data:down": "docker compose -f data/docker-compose.yml down",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
